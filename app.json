{
  "expo": {
    "name": "Xuve",
    "slug": "xuve",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "xuve",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.xuve.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ver tu ubicación en el mapa para solicitar viajes."
      }
    },
    "android": {
      "package": "com.xuve.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Mostrar tu ubicación en el mapa para solicitar transporte."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acceso a tus fotos para subir imágenes de productos.",
          "cameraPermission": "Permitir acceso a la cámara para tomar fotos de productos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "76027bd2-640f-46fc-8d04-860cd5e9ac3f"
      }
    },
    "owner": "con3xuz"
  }
}
