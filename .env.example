# ── Configuración del frontend Expo (copiar a frontend/.env) ─────────────────
# OJO: TODA variable EXPO_PUBLIC_* se compila DENTRO del bundle y es visible para
# cualquiera que abra la app. NUNCA pongas aquí secretos de servidor.

# URL del backend OMNI. En dev apunta a tu máquina; en prod a https://api.xuve.net
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Llave "A" de Google Maps — SOLO para render del mapa (Maps SDK Android/iOS/Web).
# Va en el bundle (inevitable), así que en Google Cloud Console debe estar
# restringida por firma de app (Android SHA-1 / iOS bundle id) y limitada SOLO a
# los Maps SDK. NO habilita Places/Directions/Distance Matrix/Geocoding: esas van
# por el backend con GOOGLE_MAPS_SERVER_KEY.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=pega-aqui-la-llave-de-RENDER-restringida
